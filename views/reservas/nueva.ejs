<section>

    <p class="seccion"><%= seccion %></p>
    <h1><%= titulo %></h1>

    <% if (errores.length > 0) { %>
        <div role="alert" class="error">
            <p>No se pudo guardar la reserva:</p>
            <ul>
                <% errores.forEach((error) => { %>
                    <li><%= error %></li>
                <% }) %>
            </ul>
        </div>
    <% } %>

    <%# novalidate: así el navegador no frena el envío y se prueba la validación del servidor %>
    <form action="/reservas" method="post" novalidate>

        <label for="estudiante">Estudiante</label>
        <input type="text" id="estudiante" name="estudiante" value="<%= valores.estudiante ?? '' %>" required>

        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= valores.email ?? '' %>" required>

        <label for="sala">Sala</label>
        <select id="sala" name="sala" required>
            <option value="">Elegir una sala</option>
            <% salasPermitidas.forEach((sala) => { %>
                <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>><%= sala %></option>
            <% }) %>
        </select>

        <label for="fecha">Fecha</label>
        <input type="date" id="fecha" name="fecha" value="<%= valores.fecha ?? '' %>" required>

        <label for="turno">Turno</label>
        <select id="turno" name="turno" required>
            <option value="">Elegir un turno</option>
            <% turnosPermitidos.forEach((turno) => { %>
                <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>><%= turno %></option>
            <% }) %>
        </select>

        <label for="personas">Cantidad de personas (1 a 6)</label>
        <input type="number" id="personas" name="personas" min="1" max="6" value="<%= valores.personas ?? '' %>" required>

        <button type="submit" class="boton">Reservar</button>

    </form>

</section>
